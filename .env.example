# Copy these values into your production environment's secrets manager.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_ORIGIN=https://modo.example.com
MODO_DATA_DIR=/data
# Email delivery for signup verification and password recovery.
RESEND_API_KEY=re_your_provider_api_key
RESEND_FROM=MODO <hello@your-verified-domain.com>
# Supabase Postgres. Copy the Project URL and service_role key from
# Project Settings → API. Keep the service role key on the server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
